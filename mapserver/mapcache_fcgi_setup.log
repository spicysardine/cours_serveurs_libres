#Documentation on properly setting up an Apache2 Mapserver and :apcache powerd tile server.

#check the current setup:
apachectl -M

#Install the necessary packages:
sudo apt install spawn-fcgi libapache2-mod-fcgid mapcache-cgi mapcache-tools

#look for cgi_module. If present fcgi needs to be enabled
#legacy cgi can stay enabled but should not be used for tile server or mapcache workload
#check which MPM mode is active mpm_event or mpm_prefork
#if mpm_prefork is active disable it and disable mod_php8.4
sudo a2dismod mpm_prefork
sudo a2dismod php8.4
sudo a2disconf php8.4-cgi
#install php8.4-fpm (Fast Process Manager) and enable it
sudo a2enmod mpm_event
sudo a2enconf php8.4-fpm

#disable apache2 mapcache module
sudo a2dismod mapcache

#disable legacy mapcache configuration if present
sudo a2disconf mapcache

# restart apache2
sudo systemctl restart apache2

#Enable Required Apache Modules
sudo a2enmod proxy
sudo a2enmod proxy_fcgi
sudo a2enmod setenvif
sudo systemctl restart apache2

#Step 3: Configure FastCGI Processes for MapCache
#We will use systemd to manage FastCGI processes persistently.
#Create a systemd service file for MapCache FastCGI:

sudo nano /etc/systemd/system/mapcache-fcgi.service

#Add:

[Unit]
Description=MapCache FastCGI Server
After=network.target

[Service]
User=root
Group=www-data
ExecStart=/usr/bin/spawn-fcgi -F 8 -s /run/mapcache.sock -U www-data -G www-data -- /usr/lib/cgi-bin/mapcache
Environment="MAPCACHE_CONFIG_FILE=/etc/mapcache/mapcache.xml"
Type=forking
Restart=always
RestartSec=5
StartLimitBurst=10
#KillMode=process

[Install]
WantedBy=multi-user.target

#Then
sudo systemctl daemon-reload
sudo systemctl enable mapcache-fcgi
sudo systemctl start mapcache-fcgi

#Check if your installed mapserver-bin or cgi-mapserver was built with FastCGI:
/usr/lib/cgi-bin/mapserv --version | grep -i fastcgi
#Look for SUPPORTS=FASTCGI.

#Create a new service file /etc/systemd/system/mapserver-fcgi.service:

[Unit]
Description=MapServer FastCGI Backend
After=network.target

[Service]
User=root
ExecStart=/usr/bin/spawn-fcgi -F 8 -s /run/mapserver.sock -U www-data -G www-data -- /usr/lib/cgi-bin/mapserv
Type=forking
Restart=always
RestartSec=5
Environment="MAPSERVER_CONFIG_FILE=/etc/mapserver.conf"

[Install]
WantedBy=multi-user.target


sudo systemctl daemon-reload
sudo systemctl enable mapserver-fcgi
sudo systemctl start mapserver-fcgi


#-F 6: Tune based on CPU cores (start with 4–12; MapServer benefits from multiple workers for concurrent rendering).
#Use /run/mapserver.sock (distinct from MapCache socket).
#Run as root for socket creation, drop to www-data for workers.

#Update MapCache Configuration
#In /etc/mapcache/mapcache.xml, change the WMS source to point
# to the new FastCGI endpoint instead of the CGI one:
#<source name="canada_raster_wmts" type="wms">
#  <http>
##    <!-- Replace old CGI URL with FastCGI socket via proxy or direct fcgi call -->
#    <url>http://localhost/mapserv.fcgi?</url> 
##     <!-- or use internal fcgi if supported -->
#  </http>
#  <getmap>
#    <params>
#      <FORMAT>image/png</FORMAT>
#      <LAYERS>canada_raster</LAYERS>
#      <MAP>/var/www/html/htdocs/serverGIS/mapserver/mapfiles/canada_color_web_wmts.map</MAP>
#    </params>
#  </getmap>
#</source>

#The <Location> block should not be placed arbitrarily — its exact location in 
#the Apache configuration is important for correct behavior, proper directive merging, and avoiding conflicts with other rules.
#Here is the precise and recommended placement: Recommended Location (Best Practice)
#Add this block inside the dedicated MapCache configuration file
#File: /etc/apache2/conf-available/mapcache-fcgi.conf
#Placement: Inside the existing <IfModule proxy_fcgi_module> container,
#preferably near the existing MapCache proxy rules.
#Example of the complete file after adding the MapServer backend proxy:
<IfModule proxy_fcgi_module>

    <Directory /usr/lib/cgi-bin>
        Options +ExecCGI
        Require all granted
    </Directory>

    <Location "/mapcache">
        SetHandler proxy:unix:/run/mapcache.sock|fcgi://localhost/
    </Location>

    # ────────────────────────────────────────────────────────────────
    # MapServer FastCGI backend (new addition for MapCache to use)
    # ────────────────────────────────────────────────────────────────
    <Location "/mapserv.fcgi">
        SetHandler proxy:unix:/run/mapserver.sock|fcgi://localhost/
    </Location>

    # Or alternatively:
    # ProxyPass /mapcache unix:/run/mapcache.sock|fcgi://localhost/ nocanon
    # ProxyPassReverse /mapcache unix:/run/mapcache.sock|fcgi://localhost/
</IfModule>

#Why this location is preferred?
#Keeps all FastCGI proxy rules for this tile service in one logical file.
#Makes it easy to enable/disable the entire setup with a2enconf / a2disconf.
#Avoids polluting virtual host files (000-default.conf, site-specific vhosts) with backend-specific logic.
#Ensures the rule is applied consistently across all virtual hosts that include this conf file 
#(if you later add Include /etc/apache2/conf-available/mapcache.conf in other <VirtualHost> blocks).

#refresh the services list
sudo systemctl daemon-reload
#restart apache2
sudo systemctl restart apache2



# verify and test:
#You should see 8 mapcache processes running continuously.
ps aux | grep mapcache
# if it fails pkill mapcache

watch -n1 "ps aux | grep mapcache"

#If PIDs stay the same → FastCGI is working.
#If processes constantly appear/disappear → still CGI.

#Architecture After Migration
#Browser
#↓
#Apache (mpm_event threads)
#↓
#MapCache FastCGI (persistent workers)
#↓
#Disk cache
#↓ (miss)
#MapServer FastCGI
#This is correct production architecture.

################################## working mapserver.conf file ##########################
CONFIG

  ENV
    # don’t allow arbitrary map path loading
    #MS_MAP_NO_PATH "true"                          
    # only allow map files in this directory
    #MS_MAP_PATTERN "^/var/www/html/htdocs/serverGIS/mapserver/mapfiles/.*\.map$"
    MS_MAP_PATTERN "^/var/www/html/htdocs/.*\.map$"
    # default debug verbosity
    MS_DEBUGLEVEL "2"
    #MS_VERBOSE "false"
    # Log file
    MS_ERRORFILE "/var/log/mapserver/mapserver_errors.log"
  END


  #
  # Map aliases:
  # if MS_MAP_NO_PATH "true" then the map is ONLY accessed via:
  # http://localhost/cgi-bin/mapserv?map=MAIN
  # where MAIN is the name of the alias.
  # Otherwise it accessible with or without alias
  MAPS
    MAIN                   "/var/www/html/htdocs/serverGIS/mapserver/mapfiles/hello.map"
    CANADA_COLOR           "/var/www/html/htdocs/serverGIS/mapserver/mapfiles/canada_color.map"
    CANADA_COLOR_WEB       "/var/www/html/htdocs/serverGIS/mapserver/mapfiles/canada_color_web.map"
    CANADA_COLOR_WEB_WMTS  "/var/www/html/htdocs/serverGIS/mapserver/mapfiles/canada_color_web_wmts.map"
  END

	ENV
		GDAL_NUM_THREADS '12' #"ALL_CPUS"
		GDAL_CACHEMAX "4096"
	END

END


